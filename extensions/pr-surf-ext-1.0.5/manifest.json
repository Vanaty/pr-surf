{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "PR Surf",
  "description": "__MSG_description__",
  "version": "1.0.5",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "PR Surf"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "power",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "https://api.pr.social/*",
    "https://pr.social/*",
    "<all_urls>"
  ],
  "key": ""
}