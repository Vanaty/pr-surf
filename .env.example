# =====================================================================
#  PR.social Surf Bot — Configuration
#  Copiez ce fichier en  .env  et remplissez les valeurs si besoin.
# =====================================================================

# ── Navigateur ────────────────────────────────────────────────────────
# Chemin vers un profil Chrome persistant.
# Laisser vide pour utiliser le dossier ./chrome_profile par défaut.
CHROME_PROFILE_DIR=

# ── Comportement ──────────────────────────────────────────────────────
# Temps maximum (secondes) accordé à l'utilisateur pour lier son compte
# sur pr.social après l'affichage du code (défaut : 300 = 5 minutes).
PAIR_TIMEOUT_S=300

# ── Logging ───────────────────────────────────────────────────────────
# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
